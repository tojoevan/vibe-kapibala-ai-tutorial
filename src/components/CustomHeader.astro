---
import Default from '@astrojs/starlight/components/Header.astro';

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '/zh-cn/' || pathname === '/zh-cn';
const isAbout = pathname.includes('/about');
---

<div class="custom-header-shell">
  <Default {...Astro.props}><slot /></Default>
</div>

<script>
  function injectTopMenu() {
    const siteTitle = document.querySelector('.site-title');
    
    // 注入内联顶层菜单在 SiteTitle 右侧
    if (siteTitle && !document.querySelector('.top-nav-inline-injected')) {
      const nav = document.createElement('nav');
      nav.className = 'top-nav-inline-injected';
      nav.setAttribute('aria-label', '主页顶层菜单');

      const pathname = window.location.pathname;
      const isHome = pathname === '/' || pathname === '/zh-cn/' || pathname === '/zh-cn';
      const isAbout = pathname.includes('/about');

      nav.innerHTML = `
        <a href="/" class="top-nav-link ${isHome ? 'active' : ''}">
          <svg class="nav-svg-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          首页
        </a>
        <a href="/about/" class="top-nav-link ${isAbout ? 'active' : ''}">
          <svg class="nav-svg-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          关于
        </a>
      `;

      siteTitle.after(nav);
    }
  }

  injectTopMenu();
  document.addEventListener('astro:page-load', injectTopMenu);
</script>

<style is:global>
  .custom-header-shell {
    width: 100%;
  }

  /* Header 弹性分布：左侧标题+菜单，右侧语言/深浅/搜索按钮 */
  .header {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding: 0.5rem 1.5rem !important;
  }

  /* 顶层主菜单内联注入在 SiteTitle 右侧 */
  .top-nav-inline-injected {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: 1rem;
    margin-right: 1rem;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .top-nav-inline-injected {
      display: none;
    }
  }

  .top-nav-inline-injected .top-nav-link {
    font-size: 0.825rem;
    font-weight: 500;
    padding: 0.2rem 0.55rem;
    border-radius: 0.25rem;
    color: var(--sl-color-gray-3);
    text-decoration: none !important;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: all 0.15s ease;
  }

  .top-nav-inline-injected .top-nav-link:hover {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-5);
  }

  .top-nav-inline-injected .top-nav-link.active {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-5);
    font-weight: 600;
  }

  .top-nav-inline-injected .nav-svg-icon {
    opacity: 0.75;
  }

  /* 仅调整搜索触发按钮 (Search Trigger Button) 的加宽样式，绝不污染弹窗 Modal 宽度 */
  site-search button[data-open-modal],
  starlight-search button[data-open-modal],
  site-search > button,
  starlight-search > button {
    width: 220px !important;
    justify-content: space-between !important;
  }
</style>
