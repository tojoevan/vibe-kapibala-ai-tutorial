---
import Default from '@astrojs/starlight/components/Header.astro';

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '/zh-cn/' || pathname === '/zh-cn';
const isAbout = pathname.includes('/about');
---

<div class="custom-header-shell">
  <Default {...Astro.props}><slot /></Default>
</div>

<script>
  function initCustomUI() {
    const siteTitle = document.querySelector('.site-title');
    const pathname = window.location.pathname;
    const isHome = pathname === '/' || pathname === '/en/' || pathname === '/en';

    // 1. 注入内联顶层菜单在 SiteTitle 右侧
    if (siteTitle && !document.querySelector('.top-nav-inline-injected')) {
      const nav = document.createElement('nav');
      nav.className = 'top-nav-inline-injected';
      nav.setAttribute('aria-label', '主页顶层菜单');

      const isHomeNav = pathname === '/' || pathname === '/en/' || pathname === '/en';
      const isAboutNav = pathname.includes('/about');

      nav.innerHTML = `
        <a href="/" class="top-nav-link ${isHomeNav ? 'active' : ''}">
          <svg class="nav-svg-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          首页
        </a>
        <a href="/about/" class="top-nav-link ${isAboutNav ? 'active' : ''}">
          <svg class="nav-svg-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          关于
        </a>
      `;

      siteTitle.after(nav);
    }

    // 2. 首页专享：将左侧侧边栏由树状文件目录重构为“全景分类索引”
    const sidebar = document.querySelector('.sidebar-content') || document.querySelector('starlight-sidebar');
    if (isHome && sidebar && !document.querySelector('.category-sidebar-nav')) {
      const categoryNav = document.createElement('div');
      categoryNav.className = 'category-sidebar-nav';
      categoryNav.innerHTML = `
        <ul class="category-nav-list">
          <li><a href="#ai-agent" class="category-nav-item active">01. AI Agent 智能体</a></li>
          <li><a href="#skills-workflow" class="category-nav-item">02. Skills 技能与工作流</a></li>
          <li><a href="#ai-coding" class="category-nav-item">03. AI 编程与协作工具</a></li>
          <li><a href="#llm-basics" class="category-nav-item">04. LLM 大模型基础</a></li>
          <li><a href="#prompt-eng" class="category-nav-item">05. Prompt 提示词工程</a></li>
          <li><a href="#rag-vectordb" class="category-nav-item">06. RAG 与向量数据库</a></li>
          <li><a href="#book-writing" class="category-nav-item">07. 书籍与长文写作</a></li>
          <li><a href="#site-deploy" class="category-nav-item">08. 部署与站务说明</a></li>
        </ul>
      `;

      // 替换侧边栏为纯净分类导航
      sidebar.innerHTML = '';
      sidebar.appendChild(categoryNav);

      // 🎯 核心平滑对齐滚动：带 Header Offset 的精准平滑定位
      const navLinks = categoryNav.querySelectorAll('.category-nav-item');
      navLinks.forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = link.getAttribute('href');
          const targetEl = document.querySelector(targetId);
          if (targetEl) {
            navLinks.forEach(l => l.classList.remove('active'));
            link.classList.add('active');

            // 算入 Header 吸顶高度 (72px) 与适当间距留白 (16px) ➔ offset = 88px
            const headerOffset = 88;
            const elementPosition = targetEl.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

            window.scrollTo({
              top: offsetPosition,
              behavior: 'smooth'
            });
          }
        });
      });
    }

    // 3. 教程文章页面右侧第三栏 (right-sidebar) 动态注入“精选推荐链接”模块
    const rightSidebar = document.querySelector('.right-sidebar-panel') || document.querySelector('.right-sidebar');
    if (!isHome && rightSidebar && !document.querySelector('.recommended-links-widget')) {
      const widget = document.createElement('div');
      widget.className = 'recommended-links-widget';
      widget.innerHTML = `
        <div class="rec-widget-title">精选推荐与工具</div>
        <ul class="rec-widget-list">
          <li>
            <a href="/prompt-basic/" class="rec-widget-link">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
              Claude Code 命令行工具
            </a>
          </li>
          <li>
            <a href="/llm-agent-overview/" class="rec-widget-link">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
              Agent Skills 规范指南
            </a>
          </li>
          <li>
            <a href="/cloudflare-github-deploy/" class="rec-widget-link">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
              Cloudflare Pages 部署
            </a>
          </li>
        </ul>
      `;
      rightSidebar.appendChild(widget);
    }
  }

  initCustomUI();
  document.addEventListener('astro:page-load', initCustomUI);
</script>

<style is:global>
  .custom-header-shell {
    width: 100%;
  }

  /* Header 弹性分布：左侧标题+菜单，右侧语言/深浅/搜索按钮 */
  .header {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding: 0.5rem 1.5rem !important;
  }

  /* 顶层主菜单内联注入在 SiteTitle 右侧 */
  .top-nav-inline-injected {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: 1rem;
    margin-right: 1rem;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .top-nav-inline-injected {
      display: none;
    }
  }

  .top-nav-inline-injected .top-nav-link {
    font-size: 0.825rem;
    font-weight: 500;
    padding: 0.2rem 0.55rem;
    border-radius: 0.25rem;
    color: var(--sl-color-gray-3);
    text-decoration: none !important;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: all 0.15s ease;
  }

  .top-nav-inline-injected .top-nav-link:hover {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-5);
  }

  .top-nav-inline-injected .top-nav-link.active {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-5);
    font-weight: 600;
  }

  .top-nav-inline-injected .nav-svg-icon {
    opacity: 0.75;
  }

  /* 右侧操作区严格右对齐靠最右 */
  .header .sl-flex.print\:hidden,
  .header .sl-flex:last-child {
    margin-left: auto !important;
  }

  /* 仅调整搜索触发按钮 (Search Trigger Button) 的加宽样式 */
  site-search button[data-open-modal],
  starlight-search button[data-open-modal],
  site-search > button,
  starlight-search > button {
    width: 200px !important;
    justify-content: space-between !important;
  }

  /* 首页左侧分类导航样式 */
  .category-sidebar-nav {
    padding: 1.25rem 0.75rem 1.25rem 0.75rem !important;
  }

  .category-nav-list {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .category-nav-list li {
    margin-bottom: 0.35rem !important;
  }

  .category-nav-item {
    display: block;
    font-size: 0.84rem !important;
    font-weight: 500;
    padding: 0.45rem 0.65rem;
    border-radius: 0.375rem;
    color: var(--sl-color-gray-2);
    text-decoration: none !important;
    transition: all 0.15s ease;
  }

  .category-nav-item:hover {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-5);
  }

  .category-nav-item.active {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-5);
    font-weight: 600;
  }

  /* 右侧推荐链接挂件 (Recommended Links Widget) 样式 */
  .recommended-links-widget {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--sl-color-gray-5);
  }

  .rec-widget-title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--sl-color-white);
    margin-bottom: 0.65rem;
    letter-spacing: -0.01em;
  }

  .rec-widget-list {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .rec-widget-list li {
    margin-bottom: 0.45rem !important;
  }

  .rec-widget-link {
    font-size: 0.8125rem !important;
    color: var(--sl-color-gray-3) !important;
    text-decoration: none !important;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.15s ease;
  }

  .rec-widget-link:hover {
    color: var(--sl-color-white) !important;
  }
</style>
