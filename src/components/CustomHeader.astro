---
import Default from '@astrojs/starlight/components/Header.astro';

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '/zh-cn/' || pathname === '/zh-cn';
const isAbout = pathname.includes('/about');
---

<div class="custom-header-wrapper">
  <!-- 顶层全局主菜单 (包含 首页、关于，预留扩展) -->
  <div class="global-top-bar">
    <div class="top-nav-links">
      <a href="/" class:list={['top-link', { active: isHome }]}>
        <svg class="top-link-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        首页
      </a>
      <a href="/about/" class:list={['top-link', { active: isAbout }]}>
        <svg class="top-link-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        关于
      </a>
    </div>
  </div>

  <!-- Starlight 默认搜索与标题栏 -->
  <Default {...Astro.props}><slot /></Default>
</div>

<style>
  .custom-header-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .global-top-bar {
    background-color: var(--sl-color-gray-6);
    border-bottom: 1px solid var(--sl-color-gray-5);
    padding: 0.35rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .top-nav-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .top-link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--sl-color-gray-3);
    text-decoration: none !important;
    transition: all 0.15s ease-in-out;
  }

  .top-link:hover {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-5);
  }

  .top-link.active {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-5);
    font-weight: 600;
  }

  .top-link-icon {
    opacity: 0.8;
  }
</style>
