---
import Default from '@astrojs/starlight/components/Header.astro';

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '/zh-cn/' || pathname === '/zh-cn';
const isAbout = pathname.includes('/about');
---

<div class="header-override-container">
  <Default {...Astro.props}><slot /></Default>
  
  <!-- 顶层主菜单 (内联在标题右侧，使用纯极简矢量 Icon) -->
  <nav class="top-nav-inline" aria-label="主页顶层菜单">
    <a href="/" class:list={['top-nav-link', { active: isHome }]}>
      <svg class="nav-svg-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
      首页
    </a>
    <a href="/about/" class:list={['top-nav-link', { active: isAbout }]}>
      <svg class="nav-svg-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
      关于
    </a>
  </nav>
</div>

<style>
  .header-override-container {
    display: flex;
    align-items: center;
    width: 100%;
    position: relative;
  }

  .header-override-container :global(.header) {
    width: 100%;
  }

  .top-nav-inline {
    position: absolute;
    left: 230px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: 0.25rem;
    z-index: 10;
  }

  @media (max-width: 768px) {
    .top-nav-inline {
      display: none;
    }
  }

  .top-nav-link {
    font-size: 0.825rem;
    font-weight: 500;
    padding: 0.2rem 0.55rem;
    border-radius: 0.25rem;
    color: var(--sl-color-gray-3);
    text-decoration: none !important;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: all 0.15s ease;
  }

  .top-nav-link:hover {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-5);
  }

  .top-nav-link.active {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-5);
    font-weight: 600;
  }

  .nav-svg-icon {
    opacity: 0.75;
  }
</style>
