---
import Default from '@astrojs/starlight/components/Header.astro';

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '/zh-cn/' || pathname === '/zh-cn';
const isAbout = pathname.includes('/about');
---

<div class="header-override-container">
  <Default {...Astro.props}><slot /></Default>
  
  <!-- 顶层主菜单 (注入在标题右侧) -->
  <nav class="top-nav-inline" aria-label="主页顶层菜单">
    <a href="/" class:list={['top-nav-link', { active: isHome }]}>
      首页
    </a>
    <a href="/about/" class:list={['top-nav-link', { active: isAbout }]}>
      关于
    </a>
  </nav>
</div>

<style>
  .header-override-container {
    display: flex;
    align-items: center;
    width: 100%;
    position: relative;
  }

  /* 调整 Starlight 原生 Header 内联显示 */
  .header-override-container :global(.header) {
    width: 100%;
  }

  .top-nav-inline {
    position: absolute;
    left: 240px; /* 紧跟在网站标题右侧 */
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    z-index: 10;
  }

  @media (max-width: 768px) {
    .top-nav-inline {
      display: none; /* 移动端在小屏幕隐藏或自适应 */
    }
  }

  .top-nav-link {
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.25rem 0.65rem;
    border-radius: 0.35rem;
    color: var(--sl-color-gray-3);
    text-decoration: none !important;
    transition: all 0.15s ease;
  }

  .top-nav-link:hover {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-5);
  }

  .top-nav-link.active {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-5);
    font-weight: 600;
  }
</style>
